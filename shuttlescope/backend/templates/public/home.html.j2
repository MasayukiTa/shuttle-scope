<link rel="canonical" href="https://shuttle-scope.com/">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:url" content="https://shuttle-scope.com/">
<meta property="og:title" content="ShuttleScope — バドミントン試合分析プラットフォーム">
<meta property="og:description" content="ストローク単位の記録から試合構造を統計的に可視化するバドミントン分析ワークベンチ。">
<meta property="og:image" content="https://shuttle-scope.com/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="ShuttleScope">
<meta name="twitter:description" content="ストローク単位の記録から試合構造を統計的に可視化するバドミントン分析ワークベンチ。">
<meta name="twitter:image" content="https://shuttle-scope.com/og-image.png">
<!-- 外部フォント CDN 禁止 (企業 TLS でブロックされるため): system-ui スタックのみ使用。 -->
<!-- Material Symbols CDN も廃止済み: theme トグルはインライン SVG に置換済み。 -->
<style>
/* ═══ design-tokens.css インライン (DESIGN_DIRECTION_v2.md §2/§4/§5/§7 準拠)。
   home.html.j2 は base.html.j2 を継承しない単独ドキュメントのため、ここにも
   同じトークンをインラインする。backend/public/design-tokens.css と値を同期させること。 ═══ */
:root,
[data-theme="light"] {
  --ss-brand:         #2563eb;
  --ss-brand-hover:   #1d4fd7;
  --ss-brand-tint:    rgba(37, 99, 235, 0.08);
  --ss-focus-ring:    rgba(37, 99, 235, 0.32);

  --ss-bg-app:        #f5f6f8;
  --ss-surface-1:     #ffffff;
  --ss-surface-2:     #eef1f5;
  --ss-surface-3:     #e4e8ee;

  --ss-border:        #e3e7ec;
  --ss-border-strong: #c9d1db;

  --ss-t1: #1a2028;
  --ss-t2: #55606e;
  --ss-t3: #8892a0;

  --ss-good:     #1f6fe0;
  --ss-bad:      #c2334a;
  --ss-warn:     #b26a00;
  --ss-success:  #197a48;
  --ss-emphasis: #e4610f;

  --r-sm:   3px;
  --r-md:   5px;
  --r-lg:   6px;
  --r-xl:   8px;
  --r-pill: 999px;

  --e0: none;
  --e1: 0 1px 2px rgba(16, 24, 40, 0.06);
  --e2: 0 1px 3px rgba(16, 24, 40, 0.10), 0 1px 2px rgba(16, 24, 40, 0.06);
  --e3: 0 10px 28px rgba(16, 24, 40, 0.14);

  --dur-fast: 120ms;
  --dur-base: 180ms;
  --dur-slow: 300ms;
  --ease-out: cubic-bezier(0.2, 0, 0, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);

  color-scheme: light;
}

[data-theme="dark"] {
  --ss-brand:         #5c9bff;
  --ss-brand-hover:   #7fb0ff;
  --ss-brand-tint:    rgba(92, 155, 255, 0.14);
  --ss-focus-ring:    rgba(92, 155, 255, 0.35);

  --ss-bg-app:        #1c1f24;
  --ss-surface-1:     #23272e;
  --ss-surface-2:     #2a2f37;
  --ss-surface-3:     #323842;

  --ss-border:        #363c46;
  --ss-border-strong: #454c58;

  --ss-t1: #e6e9ed;
  --ss-t2: #a5aebb;
  --ss-t3: #727c89;

  --ss-good:     #6aa6ff;
  --ss-bad:      #f0808a;
  --ss-warn:     #fcd34d;
  --ss-success:  #4bae7a;
  --ss-emphasis: #f97316;

  color-scheme: dark;
}

.ss-num { font-variant-numeric: tabular-nums slashed-zero; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans JP","Hiragino Sans","Yu Gothic UI",sans-serif;background:var(--ss-bg-app);color:var(--ss-t1);line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--ss-bg-app)}::-webkit-scrollbar-thumb{background:var(--ss-border-strong);border-radius:var(--r-sm)}
body,nav,.hero-panel,.feat-card,.uc-card,.sec-data,.sec-fcta{transition:background-color var(--dur-base) var(--ease-out),border-color var(--dur-base) var(--ease-out),color var(--dur-fast) var(--ease-out)}
:focus-visible{outline:2px solid var(--ss-brand);outline-offset:2px}

nav{position:fixed;top:0;left:0;right:0;z-index:200;height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 40px;background:rgba(245,246,248,0.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--ss-border)}
[data-theme="dark"] nav{background:rgba(28,31,36,0.92)}
.logo{font-size:18px;font-weight:600;letter-spacing:-.01em;color:var(--ss-t1);text-decoration:none;display:flex;align-items:center;gap:8px}
.logo-mark{width:26px;height:26px;background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;overflow:hidden}
.logo-mark img{width:100%;height:100%;object-fit:contain;display:block}
.nav-links{display:flex;align-items:center;gap:28px;list-style:none}
.nav-links a{font-size:13px;font-weight:500;color:var(--ss-t2);text-decoration:none;transition:color var(--dur-fast) var(--ease-out)}
.nav-links a:hover{color:var(--ss-t1)}
.nav-right{display:flex;align-items:center;gap:8px}
.theme-toggle{width:34px;height:34px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;line-height:1;transition:background var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out);color:var(--ss-t2)}
.theme-toggle svg{width:17px;height:17px;display:block}
/* light テーマ時は月(=dark へ切替), dark テーマ時は太陽(=light へ切替)を表示 */
[data-theme="light"] .theme-toggle .ic-sun{display:none}
[data-theme="dark"] .theme-toggle .ic-moon{display:none}
.theme-toggle:hover{background:var(--ss-brand-tint);border-color:var(--ss-brand)}
.lang-toggle{width:34px;height:34px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--ss-t2);transition:background var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out),color var(--dur-fast) var(--ease-out)}
.lang-toggle:hover{background:var(--ss-brand-tint);border-color:var(--ss-brand);color:var(--ss-brand)}
html[lang=en] .ja{display:none}
html[lang=ja] .en{display:none}
.btn-login{font-size:12px;font-weight:600;padding:7px 18px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);color:var(--ss-t2);background:transparent;text-decoration:none;transition:all var(--dur-fast) var(--ease-out)}
.btn-login:hover{color:var(--ss-t1);border-color:var(--ss-brand);background:var(--ss-brand-tint)}
.hamburger{display:none;flex-direction:column;justify-content:center;gap:4px;width:36px;height:36px;cursor:pointer;background:none;border:none;padding:4px}
.hamburger span{display:block;height:1.5px;background:var(--ss-t2);transition:transform var(--dur-fast) var(--ease-out),opacity var(--dur-fast) var(--ease-out);border-radius:1px}
.hamburger.open span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}
/* mobile-menu は <nav> なので nav{} の backdrop-filter/半透明背景を継承する。
   開いた時に背景が透けて文字が読めない問題を防ぐため、不透明背景を明示し
   継承した backdrop-filter を打ち消す。 */
.mobile-menu{display:none;position:fixed;top:58px;left:0;right:0;z-index:190;height:auto;max-height:calc(100vh - 58px);overflow-y:auto;padding:0;align-items:stretch;justify-content:flex-start;background:var(--ss-surface-1) !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;border-bottom:1px solid var(--ss-border);flex-direction:column;box-shadow:var(--e3)}
.mobile-menu.open{display:flex}
.mobile-menu a{font-size:14px;color:var(--ss-t1);text-decoration:none;padding:14px 24px;border-bottom:1px solid var(--ss-border);transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}
.mobile-menu a:hover{color:var(--ss-t1);background:var(--ss-brand-tint)}

/* ── Hero: 光量の高いネイビーではなく soft gray canvas + 極薄い hairline グリッド。
   Precision on Gray の核心表現 (§0/§7)。 ── */
.hero{position:relative;background:var(--ss-bg-app);padding:104px 40px 72px;overflow:hidden;border-bottom:1px solid var(--ss-border)}
.hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(var(--ss-border) 1px,transparent 1px),linear-gradient(90deg,var(--ss-border) 1px,transparent 1px);background-size:56px 56px;opacity:.5;-webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 40%,transparent 100%);mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 40%,transparent 100%);pointer-events:none;z-index:0}
.hero-inner{position:relative;z-index:1;max-width:1160px;margin:0 auto;display:grid;grid-template-columns:1fr 520px;gap:56px;align-items:center}
.hero-kicker{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.06em;color:var(--ss-brand);margin-bottom:16px;text-transform:uppercase}
.hero-kicker::before{content:'';width:18px;height:2px;background:var(--ss-brand)}
h1.hero-h1{font-size:clamp(26px,3.2vw,40px);font-weight:600;line-height:1.2;letter-spacing:-.014em;color:var(--ss-t1);margin-bottom:14px}
.hero-tagline{font-size:clamp(16px,1.6vw,19px);font-weight:500;color:var(--ss-t2);line-height:1.7;margin-bottom:22px;max-width:520px}
.hero-sub{font-size:14px;color:var(--ss-t2);line-height:1.9;max-width:480px;margin-bottom:28px}
.hero-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px}
.htag{font-size:11px;font-weight:500;color:var(--ss-t2);border:1px solid var(--ss-border);background:var(--ss-surface-1);padding:4px 10px;border-radius:var(--r-sm);letter-spacing:.01em}
.hero-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.btn-cta{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:600;padding:12px 28px;background:var(--ss-brand);color:#fff;border:none;border-radius:var(--r-md);text-decoration:none;cursor:pointer;letter-spacing:.01em;transition:background var(--dur-fast) var(--ease-out)}
.btn-cta:hover{background:var(--ss-brand-hover)}
.btn-ghost{font-size:13px;font-weight:500;color:var(--ss-t2);text-decoration:none;padding:6px 2px;border-bottom:1px solid var(--ss-border-strong);transition:color var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out)}
.btn-ghost:hover{color:var(--ss-t1);border-color:var(--ss-t2)}

/* hero-panel: 実アプリ (解析ダッシュボード) のスクリーンショット。テーマに合わせて切替 */
.hero-panel{background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--e3)}
.hero-shot{display:block;width:100%;height:auto}
.hero-shot-dark{display:none}
[data-theme="dark"] .hero-shot-light{display:none}
[data-theme="dark"] .hero-shot-dark{display:block}

.sec{padding:80px 40px}.sec-wrap{max-width:1160px;margin:0 auto}
.sec-kicker{display:inline-flex;align-items:center;gap:8px;font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--ss-brand);margin-bottom:10px;text-transform:uppercase}
.sec-kicker::before{content:'';width:18px;height:2px;background:var(--ss-brand)}
.sec-h2{font-size:clamp(19px,2.2vw,26px);font-weight:600;letter-spacing:-.014em;color:var(--ss-t1);line-height:1.3;margin-bottom:10px}
.sec-sub{font-size:14px;color:var(--ss-t2);line-height:1.85;max-width:520px;margin-bottom:48px}

.sec-features{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);border-bottom:1px solid var(--ss-border)}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--ss-border);border:1px solid var(--ss-border);border-radius:var(--r-lg);overflow:hidden}
.feat-card{background:var(--ss-surface-1);padding:28px 24px 24px;position:relative;overflow:hidden;transition:background var(--dur-fast) var(--ease-out)}
.feat-card:hover{background:var(--ss-surface-2)}
.feat-icon{width:36px;height:36px;border-radius:var(--r-md);background:var(--ss-brand-tint);border:1px solid var(--ss-border);display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.feat-icon svg{width:17px;height:17px}
.feat-h{font-size:15px;font-weight:600;color:var(--ss-t1);margin-bottom:8px}
.feat-p{font-size:13px;color:var(--ss-t2);line-height:1.8}

.sec-uc{background:var(--ss-bg-app)}
.uc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.uc-card{background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r-lg);padding:24px;display:flex;gap:18px;box-shadow:var(--e1);transition:border-color var(--dur-fast) var(--ease-out),box-shadow var(--dur-fast) var(--ease-out),transform var(--dur-fast) var(--ease-out)}
.uc-card:hover{border-color:var(--ss-border-strong);box-shadow:var(--e2);transform:translateY(-1px)}
.uc-h{font-size:14px;font-weight:600;color:var(--ss-t1);margin-bottom:6px}
.uc-p{font-size:12px;color:var(--ss-t2);line-height:1.8}

.sec-data{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);border-bottom:1px solid var(--ss-border);padding:56px 40px}
.data-body{font-size:13px;color:var(--ss-t2);line-height:1.85;max-width:640px}
.data-body a{color:var(--ss-brand);text-decoration:none}
.data-body a:hover{text-decoration:underline}

.sec-fcta{background:var(--ss-bg-app);padding:88px 40px;text-align:center;border-top:1px solid var(--ss-border)}
.fcta-h{font-size:clamp(19px,2.2vw,26px);font-weight:600;letter-spacing:-.014em;color:var(--ss-t1);margin-bottom:12px}
.fcta-sub{font-size:14px;color:var(--ss-t2);margin-bottom:32px}

footer{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);padding:24px 40px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;transition:background var(--dur-base) var(--ease-out)}
.footer-logo{font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--ss-t1);text-decoration:none;display:flex;align-items:center;gap:8px}
.footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:12px 20px;list-style:none}
.footer-links a{font-size:12px;color:var(--ss-t2);text-decoration:none;white-space:nowrap;transition:color var(--dur-fast) var(--ease-out)}
.footer-links a:hover{color:var(--ss-t1)}
.footer-copy{font-size:11px;color:var(--ss-t3)}

.mob-bar{display:none}

.beta-banner{background:var(--ss-brand-tint);border-bottom:1px solid var(--ss-border);padding:14px 40px;margin-top:58px}
.beta-banner-inner{max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;text-align:center}
.beta-badge{font-size:11px;font-weight:700;letter-spacing:.14em;color:var(--ss-brand);background:transparent;border:1px solid var(--ss-brand);border-radius:var(--r-sm);padding:3px 10px;white-space:nowrap;flex-shrink:0}
.beta-text{font-size:13px;color:var(--ss-t2);line-height:1.7;margin:0}
.beta-text strong{color:var(--ss-t1);font-weight:600}
.beta-text a{color:var(--ss-brand);text-decoration:none;border-bottom:1px solid var(--ss-brand);transition:border-color var(--dur-fast) var(--ease-out)}
.beta-text a:hover{border-bottom-color:transparent}

@media(max-width:767px){
  .beta-banner{padding:12px 16px}.beta-text{font-size:12px}
  nav{padding:0 16px}.nav-links{display:none}.btn-login{display:none}.hamburger{display:flex}
  .hero{padding:48px 20px 88px}.hero-inner{grid-template-columns:1fr;gap:0}.hero-panel{margin-top:32px}
  h1.hero-h1{font-size:clamp(24px,7vw,32px)}.hero-tagline{font-size:clamp(15px,4.5vw,18px)}
  .hero-sub{font-size:13px;margin-bottom:20px}.hero-actions{flex-direction:column;align-items:stretch}
  .hero-tags{margin-bottom:28px;gap:6px}.htag{font-size:10px;padding:3px 8px}
  .btn-cta{width:100%;justify-content:center;font-size:15px;padding:14px}.btn-ghost{display:none}
  .sec{padding:52px 20px}.sec-sub{margin-bottom:28px}.feat-grid{grid-template-columns:1fr}
  .uc-grid{grid-template-columns:1fr}.uc-card{padding:18px 16px;gap:12px}
  .sec-data{padding:44px 20px}.sec-fcta{padding:56px 20px 100px}
  footer{padding:20px 16px;flex-direction:column;padding-bottom:84px}
  .mob-bar{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:300;padding:10px 14px;background:rgba(245,246,248,0.96);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--ss-border);box-shadow:0 -2px 12px rgba(16,24,40,.08);gap:10px;align-items:center;transition:background var(--dur-base) var(--ease-out)}
  [data-theme="dark"] .mob-bar{background:rgba(28,31,36,0.96);box-shadow:0 -2px 12px rgba(0,0,0,.32)}
  .mob-bar .btn-cta{flex:1;justify-content:center;font-size:15px;padding:13px}
  .mob-bar-login{font-size:12px;font-weight:600;padding:12px 16px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);color:var(--ss-t2);background:var(--ss-surface-1);text-decoration:none;white-space:nowrap;transition:all var(--dur-fast) var(--ease-out)}
  .mob-bar-login:hover{color:var(--ss-t1);border-color:var(--ss-brand)}
}
@media(min-width:768px) and (max-width:1023px){
  nav{padding:0 28px}.nav-links{gap:18px}.nav-links li:nth-child(3){display:none}
  .hero{padding:88px 28px 56px}.hero-inner{grid-template-columns:1fr 380px;gap:36px}
  h1.hero-h1{font-size:clamp(26px,4vw,34px)}.sec{padding:64px 28px}
  .sec-data{padding:48px 28px}.sec-fcta{padding:64px 28px}footer{padding:22px 28px}
}
@media(min-width:1024px){
  .hamburger{display:none}.mob-bar{display:none}.mobile-menu{display:none!important}
}
</style>
</head>
<body>

<nav>
  <a class="logo" href="/"><div class="logo-mark"><img src="/favicon.png" alt=""></div>ShuttleScope</a>
  <ul class="nav-links">
    <li><a href="#features"><span class="ja">機能</span><span class="en">Features</span></a></li>
    <li><a href="#usecases"><span class="ja">利用シーン</span><span class="en">Use Cases</span></a></li>
    <li><a href="/privacy"><span class="ja">プライバシーポリシー</span><span class="en">Privacy Policy</span></a></li>
    <li><a href="/contact"><span class="ja">お問い合わせ</span><span class="en">Contact</span></a></li>
    <li><a href="/status"><span class="ja">稼働状況</span><span class="en">Status</span></a></li>
  </ul>
