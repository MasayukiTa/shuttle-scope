{% raw %}<!DOCTYPE html>
<html lang="ja" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShuttleScope — バドミントン試合分析プラットフォーム</title>
<meta name="description" content="ストローク単位の記録から試合構造を統計的に可視化するバドミントン分析ワークベンチ。コーチ・アナリスト・選手それぞれの役割に応じた分析レイヤーを提供します。">
<link rel="canonical" href="https://shuttle-scope.com/">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:url" content="https://shuttle-scope.com/">
<meta property="og:title" content="ShuttleScope — バドミントン試合分析プラットフォーム">
<meta property="og:description" content="ストローク単位の記録から試合構造を統計的に可視化するバドミントン分析ワークベンチ。">
<meta property="og:image" content="https://shuttle-scope.com/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="ShuttleScope">
<meta name="twitter:description" content="ストローク単位の記録から試合構造を統計的に可視化するバドミントン分析ワークベンチ。">
<meta name="twitter:image" content="https://shuttle-scope.com/og-image.png">
<!-- 外部フォント CDN 禁止 (企業 TLS でブロックされるため): system-ui スタックのみ使用。 -->
<!-- Material Symbols CDN も廃止済み: theme トグルはインライン SVG に置換済み。 -->
<style>
/* ═══ このページ専用トークン。
   home.html.j2 は base.html.j2 を継承しない単独ドキュメント。--ss-* の仕組み (light/dark を
   [data-theme] で切替) は design-tokens.css と同じだが、トップページは「コート緑 + シャトル白 +
   アクセント1色」の配色にするため brand / surface / text の値を意図的に変えている
   (design-tokens.css と値を同期させる対象ではない)。他の公開ページ (base.html.j2) は従来の配色のまま。
   文字色は WCAG AA (本文 4.5:1) を light / dark の両方で満たす値にしてある。 ═══ */
:root,
[data-theme="light"] {
  --ss-brand:         #0d6847;
  --ss-brand-hover:   #095338;
  --ss-on-brand:      #ffffff;
  --ss-brand-tint:    rgba(13, 104, 71, 0.09);
  --ss-focus-ring:    rgba(13, 104, 71, 0.38);
  --ss-accent:        #b4480b;
  --ss-on-accent:     #ffffff;

  --ss-bg-app:        #f5f7f3;
  --ss-surface-1:     #ffffff;
  --ss-surface-2:     #edf1ec;
  --ss-surface-3:     #e1e7e0;

  --ss-border:        #dce3db;
  --ss-border-strong: #aab8ad;

  --ss-t1: #15211b;
  --ss-t2: #4b5a51;
  --ss-t3: #637269;

  --court-out:  #14573d;
  --court:      #1b7a55;
  --court-line: #ffffff;
  --heat:       #ffb94d;
  --nav-bg:     rgba(245, 247, 243, 0.92);

  --r-sm:   3px;
  --r-md:   5px;
  --r-lg:   10px;
  --r-xl:   14px;
  --r-pill: 999px;

  --e1: 0 1px 2px rgba(16, 32, 24, 0.06);
  --e2: 0 2px 6px rgba(16, 32, 24, 0.08), 0 1px 2px rgba(16, 32, 24, 0.06);
  --e3: 0 10px 28px rgba(16, 32, 24, 0.14);

  --dur-fast: 120ms;
  --dur-base: 180ms;
  --ease-out: cubic-bezier(0.2, 0, 0, 1);

  color-scheme: light;
}

[data-theme="dark"] {
  --ss-brand:         #5cc596;
  --ss-brand-hover:   #7bd4ac;
  --ss-on-brand:      #06150d;
  --ss-brand-tint:    rgba(92, 197, 150, 0.13);
  --ss-focus-ring:    rgba(92, 197, 150, 0.4);
  --ss-accent:        #f2a05a;
  --ss-on-accent:     #1d1106;

  --ss-bg-app:        #101814;
  --ss-surface-1:     #17211c;
  --ss-surface-2:     #1d2923;
  --ss-surface-3:     #25332c;

  --ss-border:        #2c3b33;
  --ss-border-strong: #405347;

  --ss-t1: #e7efe9;
  --ss-t2: #a8b8ad;
  --ss-t3: #8a9b90;

  --court-out:  #0f3f2d;
  --court:      #176247;
  --nav-bg:     rgba(16, 24, 20, 0.92);

  --e1: 0 1px 2px rgba(0, 0, 0, 0.3);
  --e2: 0 2px 6px rgba(0, 0, 0, 0.35);
  --e3: 0 10px 28px rgba(0, 0, 0, 0.45);

  color-scheme: dark;
}

.ss-num { font-variant-numeric: tabular-nums slashed-zero; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans JP","Hiragino Sans","Yu Gothic UI",sans-serif;background:var(--ss-bg-app);color:var(--ss-t1);line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased;line-break:strict;word-break:auto-phrase}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--ss-bg-app)}::-webkit-scrollbar-thumb{background:var(--ss-border-strong);border-radius:var(--r-sm)}
body,nav,.sec-features,.sec-data,.sec-fcta,.court-panel,.mini{transition:background-color var(--dur-base) var(--ease-out),border-color var(--dur-base) var(--ease-out),color var(--dur-fast) var(--ease-out)}
:focus-visible{outline:2px solid var(--ss-brand);outline-offset:2px}
.nb{display:inline-block}

nav{position:fixed;top:0;left:0;right:0;z-index:200;height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 40px;background:var(--nav-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--ss-border)}
.logo{font-size:18px;font-weight:600;letter-spacing:-.01em;color:var(--ss-t1);text-decoration:none;display:flex;align-items:center;gap:8px}
.logo-mark{width:26px;height:26px;background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;overflow:hidden}
.logo-mark img{width:100%;height:100%;object-fit:contain;display:block}
.nav-links{display:flex;align-items:center;gap:28px;list-style:none}
.nav-links a{font-size:13px;font-weight:500;color:var(--ss-t2);text-decoration:none;transition:color var(--dur-fast) var(--ease-out)}
.nav-links a:hover{color:var(--ss-t1)}
.nav-right{display:flex;align-items:center;gap:8px}
.theme-toggle{width:34px;height:34px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;line-height:1;transition:background var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out);color:var(--ss-t2)}
.theme-toggle svg{width:17px;height:17px;display:block}
/* light テーマ時は月(=dark へ切替), dark テーマ時は太陽(=light へ切替)を表示 */
[data-theme="light"] .theme-toggle .ic-sun{display:none}
[data-theme="dark"] .theme-toggle .ic-moon{display:none}
.theme-toggle:hover{background:var(--ss-brand-tint);border-color:var(--ss-brand)}
.lang-toggle{width:34px;height:34px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;color:var(--ss-t2);transition:background var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out),color var(--dur-fast) var(--ease-out)}
.lang-toggle:hover{background:var(--ss-brand-tint);border-color:var(--ss-brand);color:var(--ss-brand)}
html[lang=en] .ja{display:none}
html[lang=ja] .en{display:none}
.btn-login{font-size:12px;font-weight:600;padding:7px 18px;border:1px solid var(--ss-border-strong);border-radius:var(--r-md);color:var(--ss-t2);background:transparent;text-decoration:none;transition:all var(--dur-fast) var(--ease-out)}
.btn-login:hover{color:var(--ss-t1);border-color:var(--ss-brand);background:var(--ss-brand-tint)}
.hamburger{display:none;flex-direction:column;justify-content:center;gap:4px;width:36px;height:36px;cursor:pointer;background:none;border:none;padding:4px}
.hamburger span{display:block;height:1.5px;background:var(--ss-t2);transition:transform var(--dur-fast) var(--ease-out),opacity var(--dur-fast) var(--ease-out);border-radius:1px}
.hamburger.open span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}
/* mobile-menu は <nav> なので nav{} の backdrop-filter/半透明背景を継承する。
   開いた時に背景が透けて文字が読めない問題を防ぐため、不透明背景を明示し
   継承した backdrop-filter を打ち消す。 */
.mobile-menu{display:none;position:fixed;top:58px;left:0;right:0;z-index:190;height:auto;max-height:calc(100vh - 58px);overflow-y:auto;padding:0;align-items:stretch;justify-content:flex-start;background:var(--ss-surface-1) !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;border-bottom:1px solid var(--ss-border);flex-direction:column;box-shadow:var(--e3)}
.mobile-menu.open{display:flex}
.mobile-menu a{font-size:14px;color:var(--ss-t1);text-decoration:none;padding:14px 24px;border-bottom:1px solid var(--ss-border);transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}
.mobile-menu a:hover{color:var(--ss-t1);background:var(--ss-brand-tint)}

/* β 版のお知らせ: 1 行のコンパクトな帯。製品が最初の画面に入るよう高さを抑える。 */
.beta-banner{background:var(--ss-brand-tint);border-bottom:1px solid var(--ss-border);padding:8px 40px;margin-top:58px}
.beta-banner-inner{max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;text-align:center}
.beta-badge{font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--ss-brand);border:1px solid var(--ss-brand);border-radius:var(--r-sm);padding:1px 7px;white-space:nowrap;flex-shrink:0;line-height:1.6}
.beta-text{font-size:12.5px;color:var(--ss-t2);line-height:1.6;margin:0}
.beta-text a{color:var(--ss-brand);font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;white-space:nowrap}
.beta-text a:hover{border-bottom-color:transparent}

/* ── Hero: 製品 (コートと配球の可視化) が主役。文字は短く、CTA は 1 つだけ。 ── */
.hero{background:var(--ss-bg-app);padding:56px 40px 64px;border-bottom:1px solid var(--ss-border)}
.hero-inner{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 500px;gap:64px;align-items:center}
h1.hero-h1{font-size:clamp(28px,3.5vw,46px);font-weight:700;line-height:1.35;letter-spacing:-.01em;color:var(--ss-t1);margin-bottom:20px;text-wrap:balance}
.hero-sub{font-size:16px;color:var(--ss-t2);line-height:1.95;max-width:30em;margin-bottom:32px}
.btn-cta{display:inline-flex;align-items:center;gap:10px;font-size:15px;font-weight:600;padding:13px 30px;background:var(--ss-brand);color:var(--ss-on-brand);border:none;border-radius:var(--r-md);text-decoration:none;cursor:pointer;letter-spacing:.01em;transition:background var(--dur-fast) var(--ease-out)}
.btn-cta:hover{background:var(--ss-brand-hover)}

/* court-panel: インライン SVG のコート。サンプルデータ表示であることを必ず明示する。 */
.court-panel{background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r-xl);padding:14px 14px 12px;box-shadow:var(--e3)}
.court-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.tag-sample{font-size:11px;font-weight:700;letter-spacing:.04em;color:var(--ss-accent);border:1px solid var(--ss-accent);border-radius:var(--r-sm);padding:1px 8px;line-height:1.6;white-space:nowrap}
.court-title{font-size:13px;font-weight:600;color:var(--ss-t1)}
.court-svg{display:block;width:100%;height:auto;border-radius:var(--r-lg)}
.court-cap{font-size:12px;color:var(--ss-t2);line-height:1.8;margin-top:10px}
.legend{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--ss-t2);margin-top:8px}
.legend i{display:block;width:84px;height:8px;border-radius:4px;background:linear-gradient(90deg,rgba(255,185,77,.2),rgba(255,185,77,1));outline:1px solid var(--ss-border-strong)}

/* SVG 共通 */
.f-court{fill:var(--court)}.f-out{fill:var(--court-out)}
.l-court{stroke:var(--court-line);fill:none;stroke-width:2;stroke-opacity:.9}
.f-heat{fill:var(--heat)}
.t-zone{font-size:13px;font-weight:700;fill:#fff;stroke:#0a3323;stroke-width:3px;paint-order:stroke;stroke-linejoin:round}
.t-net{font-size:11px;font-weight:600;fill:rgba(255,255,255,.85);letter-spacing:.08em}
.path-seg{fill:none;stroke:#fff;stroke-width:2.2;stroke-dasharray:6 4;stroke-linecap:round;stroke-linejoin:round}
.node{fill:#fff;stroke:#0a3323;stroke-width:1.5}
.node-end{fill:var(--heat);stroke:#0a3323;stroke-width:1.5}
.t-node{font-size:12px;font-weight:700;fill:#0a3323;text-anchor:middle;dominant-baseline:central}
.t-mini{font-size:10px;fill:var(--ss-t2)}
.t-mini-w{font-size:10.5px;font-weight:600;fill:#fff}
.m-guide{stroke:var(--ss-border-strong);stroke-width:1;fill:none}
.m-guide-d{stroke:var(--ss-border-strong);stroke-width:1;fill:none;stroke-dasharray:3 3}
.m-link{stroke:var(--ss-brand);stroke-width:1.6;fill:none;stroke-linejoin:round}
.m-a{fill:var(--ss-brand);stroke:var(--ss-brand);stroke-width:1.5}
.m-b{fill:var(--ss-surface-2);stroke:var(--ss-brand);stroke-width:1.5}
.m-end{fill:var(--ss-accent);stroke:var(--ss-accent);stroke-width:1.5}
.t-on-brand{font-size:10.5px;font-weight:700;fill:var(--ss-on-brand);text-anchor:middle;dominant-baseline:central}
.t-on-b{font-size:10.5px;font-weight:700;fill:var(--ss-t1);text-anchor:middle;dominant-baseline:central}
.t-on-accent{font-size:10.5px;font-weight:700;fill:var(--ss-on-accent);text-anchor:middle;dominant-baseline:central}
.m-band{fill:var(--ss-brand);fill-opacity:.16;stroke:none}
.m-line{stroke:var(--ss-brand);stroke-width:2.2;fill:none;stroke-linejoin:round;stroke-linecap:round}
.m-seg{stroke:var(--ss-accent);stroke-width:3.4;fill:none;stroke-linejoin:round;stroke-linecap:round}
.m-dot{fill:var(--ss-accent)}
.t-acc{font-size:10.5px;font-weight:700;fill:var(--ss-accent)}

.sec{padding:80px 40px}.sec-wrap{max-width:1160px;margin:0 auto}
.sec-h2{font-size:clamp(21px,2.4vw,30px);font-weight:700;letter-spacing:-.01em;color:var(--ss-t1);line-height:1.4;margin-bottom:12px;text-wrap:balance}
.sec-sub{font-size:15px;color:var(--ss-t2);line-height:1.9;max-width:36em;margin-bottom:44px}

/* Features: 「何が得られるか」3 つ。各ブロックにそのブロック固有のミニ図とサンプル表示。 */
.sec-features{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);border-bottom:1px solid var(--ss-border)}
.view-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}
.mini{position:relative;background:var(--ss-surface-2);border:1px solid var(--ss-border);border-radius:var(--r-lg);padding:12px 12px 8px;margin-bottom:20px}
.mini .tag-sample{position:absolute;top:10px;right:10px;font-size:10px;padding:0 6px;background:var(--ss-surface-1)}
.mini svg{display:block;width:100%;height:auto}
.mini-cap{font-size:11px;color:var(--ss-t2);line-height:1.7;margin-top:6px}
.view-h{font-size:17px;font-weight:700;line-height:1.5;color:var(--ss-t1);margin-bottom:8px;text-wrap:balance}
.view-p{font-size:14px;color:var(--ss-t2);line-height:1.9;margin-bottom:14px}
.decide{font-size:13px;line-height:1.8;color:var(--ss-t1);border-top:1px solid var(--ss-border);padding-top:12px}
.decide b{display:block;font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--ss-brand);margin-bottom:2px}
.note{font-size:12.5px;color:var(--ss-t2);line-height:1.9;max-width:60em;margin-top:44px;padding-top:20px;border-top:1px solid var(--ss-border)}

/* Usecases: 実際のアプリ画面。端のにじみ (元画像に含まれる) は切り抜いて見せない。 */
.sec-uc{background:var(--ss-bg-app)}
.app-fig{margin:0 auto;max-width:1100px}
.shot-scroll{overflow-x:auto}
.shot-frame{position:relative;overflow:hidden;aspect-ratio:1618/780;border:1px solid var(--ss-border-strong);border-radius:var(--r-lg);box-shadow:var(--e2);background:var(--ss-surface-1)}
.shot-frame img{display:block;width:118.66%;max-width:none;height:auto;margin-left:-14.34%}
.shot-dark{display:none}
[data-theme="dark"] .shot-light{display:none}
[data-theme="dark"] .shot-dark{display:block}
.shot-cap{font-size:12px;color:var(--ss-t2);line-height:1.8;margin-top:10px}
.roles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;max-width:1100px;margin:44px auto 0}
.role{border-top:2px solid var(--ss-brand);padding-top:14px}
.role-h{font-size:15px;font-weight:700;color:var(--ss-t1);margin-bottom:6px}
.role-p{font-size:13.5px;color:var(--ss-t2);line-height:1.9}

.sec-data{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);border-bottom:1px solid var(--ss-border);padding:44px 40px}
.data-body{font-size:13px;color:var(--ss-t2);line-height:1.9;max-width:44em}
.data-body a{color:var(--ss-brand);text-decoration:none;border-bottom:1px solid currentColor}
.data-body a:hover{border-bottom-color:transparent}

.sec-fcta{background:var(--ss-bg-app);padding:80px 40px;text-align:center}
.fcta-h{font-size:clamp(21px,2.4vw,30px);font-weight:700;letter-spacing:-.01em;color:var(--ss-t1);margin-bottom:10px;text-wrap:balance}
.fcta-sub{font-size:14px;color:var(--ss-t2);margin-bottom:28px}

footer{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);padding:24px 40px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;transition:background var(--dur-base) var(--ease-out)}
.footer-logo{font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--ss-t1);text-decoration:none;display:flex;align-items:center;gap:8px}
.footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:12px 20px;list-style:none}
.footer-links a{font-size:12px;color:var(--ss-t2);text-decoration:none;white-space:nowrap;transition:color var(--dur-fast) var(--ease-out)}
.footer-links a:hover{color:var(--ss-t1)}
.footer-copy{font-size:11px;color:var(--ss-t3)}

@media(max-width:767px){
  .beta-banner{padding:7px 16px}.beta-text{font-size:12px}
  nav{padding:0 16px}.nav-links{display:none}.btn-login{display:none}.hamburger{display:flex}
  .hero{padding:28px 20px 40px}.hero-inner{grid-template-columns:minmax(0,1fr);gap:28px}
  h1.hero-h1{font-size:clamp(26px,7.4vw,34px);margin-bottom:14px}
  .hero-sub{font-size:14px;line-height:1.85;margin-bottom:22px}
  .btn-cta{width:100%;justify-content:center;padding:14px}
  .court-panel{padding:12px 12px 10px}
  .sec{padding:52px 20px}.sec-sub{margin-bottom:28px}
  .view-grid{grid-template-columns:minmax(0,1fr);gap:36px}
  .roles{grid-template-columns:minmax(0,1fr);gap:24px;margin-top:32px}
  .shot-frame{min-width:720px}
  .sec-data{padding:36px 20px}.sec-fcta{padding:56px 20px}
  footer{padding:20px 16px;flex-direction:column}
}
@media(min-width:768px) and (max-width:1023px){
  nav{padding:0 28px}.nav-links{gap:18px}.nav-links li:nth-child(3){display:none}
  .hero{padding:48px 28px 56px}.hero-inner{grid-template-columns:minmax(0,1fr) 380px;gap:36px}
  .sec{padding:64px 28px}.view-grid{gap:24px}.roles{gap:24px}
  .sec-data{padding:40px 28px}.sec-fcta{padding:64px 28px}footer{padding:22px 28px}
}
