{% raw %}<!DOCTYPE html>
<html lang="ja" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShuttleScope — バドミントン試合分析プラットフォーム</title>
<meta name="description" content="バドミントンの試合をストロークごとに記録し、配球やラリー、得点の流れを振り返るツール。コーチや選手が、記録した試合を確認できます。">
<link rel="canonical" href="https://shuttle-scope.com/">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:url" content="https://shuttle-scope.com/">
<meta property="og:title" content="ShuttleScope — バドミントン試合分析プラットフォーム">
<meta property="og:description" content="バドミントンの試合をストロークごとに記録し、配球やラリー、得点の流れを振り返るツール。">
<meta property="og:image" content="https://shuttle-scope.com/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="ShuttleScope">
<meta name="twitter:description" content="バドミントンの試合をストロークごとに記録し、配球やラリー、得点の流れを振り返るツール。">
<meta name="twitter:image" content="https://shuttle-scope.com/og-image.png">
<!-- 外部フォント CDN 禁止 (企業 TLS でブロックされるため): ページ全体で 1 つの system-ui スタックのみ使う。 -->
<style>
/* ═══ このページ専用トークン。
   home.html.j2 は base.html.j2 を継承しない単独ドキュメント。--ss-* の仕組み (light/dark を
   [data-theme] で切替) は design-tokens.css と同じだが、トップページは「コート緑 + シャトル白 +
   アクセント 1 色」の配色にするため、brand / surface / text の値を意図的に変えている
   (design-tokens.css と値を同期させる対象ではない)。他の公開ページ (base.html.j2) は従来の配色のまま。
   文字色は WCAG AA (本文 4.5:1) を light / dark の両方で満たす値にしてある。 ═══ */
:root,
[data-theme="light"] {
  --ss-brand:         #0d6847;
  --ss-brand-hover:   #095338;
  --ss-on-brand:      #ffffff;
  --ss-brand-tint:    rgba(13, 104, 71, 0.09);
  --ss-focus-ring:    rgba(13, 104, 71, 0.38);
  --ss-accent:        #b4480b;
  --ss-on-accent:     #ffffff;

  --ss-bg-app:        #f5f7f3;
  --ss-surface-1:     #ffffff;
  --ss-surface-2:     #edf1ec;
  --ss-surface-3:     #e1e7e0;

  --ss-border:        #dce3db;
  --ss-border-strong: #aab8ad;

  --ss-t1: #15211b;
  --ss-t2: #4b5a51;
  --ss-t3: #637269;

  --court-out:  #14573d;
  --court:      #1b7a55;
  --court-line: #ffffff;
  --heat:       #ffb94d;
  --nav-bg:     rgba(245, 247, 243, 0.92);

  /* 角丸は 1 種類に絞る (8px)。 */
  --r:      8px;
  --r-pill: 8px;

  /* 影は 1 段階だけ。浮かせる要素 (スクリーンショット) にのみ使う。 */
  --shadow: 0 2px 6px rgba(16, 32, 24, 0.08), 0 1px 2px rgba(16, 32, 24, 0.06);

  --dur-fast: 120ms;
  --dur-base: 180ms;
  --ease-out: cubic-bezier(0.2, 0, 0, 1);

  color-scheme: light;
}

[data-theme="dark"] {
  --ss-brand:         #5cc596;
  --ss-brand-hover:   #7bd4ac;
  --ss-on-brand:      #06150d;
  --ss-brand-tint:    rgba(92, 197, 150, 0.13);
  --ss-focus-ring:    rgba(92, 197, 150, 0.4);
  --ss-accent:        #f2a05a;
  --ss-on-accent:     #1d1106;

  --ss-bg-app:        #101814;
  --ss-surface-1:     #17211c;
  --ss-surface-2:     #1d2923;
  --ss-surface-3:     #25332c;

  --ss-border:        #2c3b33;
  --ss-border-strong: #405347;

  --ss-t1: #e7efe9;
  --ss-t2: #a8b8ad;
  --ss-t3: #8a9b90;

  --court-out:  #0f3f2d;
  --court:      #176247;
  --nav-bg:     rgba(16, 24, 20, 0.92);

  --shadow: 0 2px 6px rgba(0, 0, 0, 0.35);

  color-scheme: dark;
}

.ss-num { font-variant-numeric: tabular-nums slashed-zero; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

/* ページ全体で 1 つのフォントスタック。フォーム部品・ボタン・SVG 文字は inherit で揃える。 */
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans JP","Hiragino Sans","Yu Gothic UI",sans-serif;background:var(--ss-bg-app);color:var(--ss-t1);line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased;line-break:strict;word-break:auto-phrase}
button,input,select,textarea,svg text,text{font-family:inherit}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--ss-bg-app)}::-webkit-scrollbar-thumb{background:var(--ss-border-strong);border-radius:var(--r)}
body,nav,.sec-features,.sec-data,.sec-fcta,.court-panel,.mini{transition:background-color var(--dur-base) var(--ease-out),border-color var(--dur-base) var(--ease-out),color var(--dur-fast) var(--ease-out)}
:focus-visible{outline:2px solid var(--ss-brand);outline-offset:2px}
.nb{display:inline-block}

nav{position:fixed;top:0;left:0;right:0;z-index:200;height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:var(--nav-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--ss-border)}
.logo{font-size:20px;font-weight:600;letter-spacing:-.01em;color:var(--ss-t1);text-decoration:none;display:flex;align-items:center;gap:8px}
.logo-mark{width:26px;height:26px;background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r);display:flex;align-items:center;justify-content:center;overflow:hidden}
.logo-mark img{width:100%;height:100%;object-fit:contain;display:block}
.nav-links{display:flex;align-items:center;gap:24px;list-style:none}
.nav-links a{font-size:14px;font-weight:500;color:var(--ss-t2);text-decoration:none;padding:8px 4px;transition:color var(--dur-fast) var(--ease-out)}
.nav-links a:hover{color:var(--ss-t1)}
.nav-right{display:flex;align-items:center;gap:8px}
.theme-toggle{width:34px;height:34px;border:1px solid var(--ss-border-strong);border-radius:var(--r);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1;transition:background var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out);color:var(--ss-t2)}
.theme-toggle svg{width:17px;height:17px;display:block}
[data-theme="light"] .theme-toggle .ic-sun{display:none}
[data-theme="dark"] .theme-toggle .ic-moon{display:none}
.theme-toggle:hover{background:var(--ss-brand-tint);border-color:var(--ss-brand)}
.lang-toggle{min-width:34px;height:34px;padding:0 8px;border:1px solid var(--ss-border-strong);border-radius:var(--r);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;color:var(--ss-t2);transition:background var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out),color var(--dur-fast) var(--ease-out)}
.lang-toggle:hover{background:var(--ss-brand-tint);border-color:var(--ss-brand);color:var(--ss-brand)}
html[lang=en] .ja{display:none}
html[lang=ja] .en{display:none}
.btn-login{font-size:14px;font-weight:600;padding:8px 16px;min-height:34px;display:inline-flex;align-items:center;border:1px solid var(--ss-border-strong);border-radius:var(--r);color:var(--ss-t2);background:transparent;text-decoration:none;transition:color var(--dur-fast) var(--ease-out),border-color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}
.btn-login:hover{color:var(--ss-t1);border-color:var(--ss-brand);background:var(--ss-brand-tint)}
.hamburger{display:none;flex-direction:column;justify-content:center;gap:4px;width:36px;height:36px;cursor:pointer;background:none;border:none;padding:4px}
.hamburger span{display:block;height:1.5px;background:var(--ss-t2);transition:transform var(--dur-fast) var(--ease-out),opacity var(--dur-fast) var(--ease-out);border-radius:1px}
.hamburger.open span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}
.mobile-menu{display:none;position:fixed;top:58px;left:0;right:0;z-index:190;height:auto;max-height:calc(100vh - 58px);overflow-y:auto;padding:0;align-items:stretch;justify-content:flex-start;background:var(--ss-surface-1) !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;border-bottom:1px solid var(--ss-border);flex-direction:column;box-shadow:var(--shadow)}
.mobile-menu.open{display:flex}
.mobile-menu a{font-size:16px;color:var(--ss-t1);text-decoration:none;padding:16px 24px;min-height:48px;display:flex;align-items:center;border-bottom:1px solid var(--ss-border);transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}
.mobile-menu a:hover{color:var(--ss-t1);background:var(--ss-brand-tint)}

/* β 版のお知らせ: 1 行の帯。 */
.beta-banner{background:var(--ss-brand-tint);border-bottom:1px solid var(--ss-border);padding:8px 24px;margin-top:58px}
.beta-banner-inner{max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;text-align:center}
.beta-badge{font-size:14px;font-weight:700;letter-spacing:.08em;color:var(--ss-brand);border:1px solid var(--ss-brand);border-radius:var(--r);padding:2px 8px;white-space:nowrap;flex-shrink:0;line-height:1.4}
.beta-text{font-size:14px;color:var(--ss-t2);line-height:1.5;margin:0}
.beta-text a{color:var(--ss-brand);font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;white-space:nowrap;display:inline-block;min-height:24px;padding:2px 2px}
.beta-text a:hover{border-bottom-color:transparent}

/* ── Hero: コート図を横に置き、見出しはしたいことをそのまま述べる。 ── */
.hero{background:var(--ss-bg-app);padding:48px 24px;border-bottom:1px solid var(--ss-border)}
.hero-inner{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 460px;gap:48px;align-items:center}
h1.hero-h1{font-size:clamp(28px,3.2vw,32px);font-weight:700;line-height:1.25;letter-spacing:-.01em;color:var(--ss-t1);margin-bottom:16px;text-wrap:balance}
.hero-sub{font-size:16px;color:var(--ss-t2);line-height:1.8;max-width:32em;margin-bottom:24px}
.btn-cta{display:inline-flex;align-items:center;gap:8px;font-size:16px;font-weight:600;padding:14px 24px;min-height:48px;background:var(--ss-brand);color:var(--ss-on-brand);border:none;border-radius:var(--r);text-decoration:none;cursor:pointer;letter-spacing:.01em;transition:background var(--dur-fast) var(--ease-out)}
.btn-cta:hover{background:var(--ss-brand-hover)}
.cta-row{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
.btn-cta-sub{display:inline-flex;align-items:center;min-height:48px;font-size:14px;font-weight:600;padding:12px 4px;color:var(--ss-brand);text-decoration:underline;text-underline-offset:3px}
.cta-note{font-size:14px;color:var(--ss-t2);line-height:1.7;margin-top:16px;max-width:34em}

/* court-panel: インライン SVG のコート。サンプル表示であることを必ず明示する。 */
.court-panel{background:var(--ss-surface-1);border:1px solid var(--ss-border);border-radius:var(--r);padding:16px}
.court-head{display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.tag-sample{font-size:14px;font-weight:700;letter-spacing:.02em;color:var(--ss-accent);border:1px solid var(--ss-accent);border-radius:var(--r);padding:1px 8px;line-height:1.5;white-space:nowrap}
.court-title{font-size:16px;font-weight:600;color:var(--ss-t1)}
.court-svg{display:block;width:100%;height:auto;border-radius:var(--r)}
.court-cap{font-size:14px;color:var(--ss-t2);line-height:1.7;margin-top:16px}
.legend{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ss-t2);margin-top:8px}
.legend i{display:block;width:84px;height:8px;border-radius:var(--r);background:linear-gradient(90deg,rgba(255,185,77,.2),rgba(255,185,77,1));outline:1px solid var(--ss-border-strong)}

/* SVG 共通。図を読むための文字は 14px 以上にする。 */
.f-court{fill:var(--court)}.f-out{fill:var(--court-out)}
.l-court{stroke:var(--court-line);fill:none;stroke-width:2;stroke-opacity:.9}
.f-heat{fill:var(--heat)}
.t-zone{font-size:14px;font-weight:700;fill:#fff;stroke:#0a3323;stroke-width:3px;paint-order:stroke;stroke-linejoin:round}
.t-net{font-size:14px;font-weight:600;fill:rgba(255,255,255,.85);letter-spacing:.06em}
.path-seg{fill:none;stroke:#fff;stroke-width:2.2;stroke-dasharray:6 4;stroke-linecap:round;stroke-linejoin:round}
.node{fill:#fff;stroke:#0a3323;stroke-width:1.5}
.node-end{fill:var(--heat);stroke:#0a3323;stroke-width:1.5}
.t-node{font-size:14px;font-weight:700;fill:#0a3323;text-anchor:middle;dominant-baseline:central}
.t-mini{font-size:14px;fill:var(--ss-t2)}
.t-mini-w{font-size:14px;font-weight:600;fill:#fff}
.m-guide{stroke:var(--ss-border-strong);stroke-width:1;fill:none}
.m-guide-d{stroke:var(--ss-border-strong);stroke-width:1;fill:none;stroke-dasharray:3 3}
.m-link{stroke:var(--ss-brand);stroke-width:1.6;fill:none;stroke-linejoin:round}
.m-a{fill:var(--ss-brand);stroke:var(--ss-brand);stroke-width:1.5}
.m-b{fill:var(--ss-surface-2);stroke:var(--ss-brand);stroke-width:1.5}
.m-end{fill:var(--ss-accent);stroke:var(--ss-accent);stroke-width:1.5}
.t-on-brand{font-size:14px;font-weight:700;fill:var(--ss-on-brand);text-anchor:middle;dominant-baseline:central}
.t-on-b{font-size:14px;font-weight:700;fill:var(--ss-t1);text-anchor:middle;dominant-baseline:central}
.t-on-accent{font-size:14px;font-weight:700;fill:var(--ss-on-accent);text-anchor:middle;dominant-baseline:central}
.m-band{fill:var(--ss-brand);fill-opacity:.16;stroke:none}
.m-line{stroke:var(--ss-brand);stroke-width:2.2;fill:none;stroke-linejoin:round;stroke-linecap:round}
.m-seg{stroke:var(--ss-accent);stroke-width:3.4;fill:none;stroke-linejoin:round;stroke-linecap:round}
.m-dot{fill:var(--ss-accent)}
.t-acc{font-size:14px;font-weight:700;fill:var(--ss-accent)}

.sec{padding:48px 24px}.sec-wrap{max-width:1160px;margin:0 auto}
.sec-h2{font-size:clamp(20px,2.2vw,32px);font-weight:700;letter-spacing:-.01em;color:var(--ss-t1);line-height:1.3;margin-bottom:16px;text-wrap:balance}
.sec-sub{font-size:16px;color:var(--ss-t2);line-height:1.8;max-width:38em;margin-bottom:24px}

/* Usecases: 実際のアプリ画面を大きく 1 枚。上部の集計カウンターは切り抜いて見せない。 */
.sec-uc{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);border-bottom:1px solid var(--ss-border)}
.app-fig{margin:0;max-width:1100px}
.shot-frame{position:relative;overflow:hidden;aspect-ratio:1000/320;border:1px solid var(--ss-border);border-radius:var(--r);background:var(--ss-surface-1)}
.shot-frame img{display:block;width:111.4%;max-width:none;height:100%;margin-left:-5.7%;object-fit:cover;object-position:50% 100%}
.shot-dark{display:none}
[data-theme="dark"] .shot-light{display:none}
[data-theme="dark"] .shot-dark{display:block}
.shot-cap{font-size:14px;color:var(--ss-t2);line-height:1.7;margin-top:16px}
.shot-points{list-style:none;counter-reset:n;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:1100px;margin:24px 0 0}
.shot-points li{counter-increment:n;position:relative;padding-left:32px;font-size:14px;color:var(--ss-t2);line-height:1.7}
.shot-points li::before{content:counter(n);position:absolute;left:0;top:0;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--ss-on-brand);background:var(--ss-brand);border-radius:var(--r)}
.shot-points b{color:var(--ss-t1);font-weight:700}

/* Features: 左右交互の行。幅を揃えず、図と文を並べる。 */
.sec-features{background:var(--ss-bg-app)}
.vrow{display:grid;grid-template-columns:var(--vc,1.1fr 1fr);gap:48px;align-items:center;max-width:1040px}
.vrow + .vrow{margin-top:48px}
.vrow.rev{grid-template-columns:var(--vc,1fr 1.1fr);margin-left:auto}
.vrow.rev .vfig{order:2}
.vrow.rev .vtext{order:1}
.vwide{--vc:1.3fr 1fr;max-width:1100px}
.vnarrow{--vc:1fr 1.25fr;max-width:960px}
.mini{position:relative;background:var(--ss-surface-2);border:1px solid var(--ss-border);border-radius:var(--r);padding:16px}
.mini .tag-sample{position:absolute;top:8px;right:8px;font-size:14px;padding:0 8px;background:var(--ss-surface-1)}
.mini svg{display:block;width:100%;height:auto}
.mini-cap{font-size:14px;color:var(--ss-t2);line-height:1.6;margin-top:8px}
.view-h{font-size:20px;font-weight:700;line-height:1.3;color:var(--ss-t1);margin-bottom:8px;text-wrap:balance}
.view-p{font-size:16px;color:var(--ss-t2);line-height:1.8}
.note{font-size:14px;color:var(--ss-t2);line-height:1.8;max-width:60em;margin-top:48px;padding-top:24px;border-top:1px solid var(--ss-border)}
.method{font-size:14px;color:var(--ss-t2);line-height:1.8;max-width:60em;margin-top:16px}
.method-p{margin-top:8px}
.method summary{cursor:pointer;font-weight:600;padding:8px 0;min-height:24px}

.roles{max-width:1100px;margin:24px 0 0;border-top:1px solid var(--ss-border)}
.role{display:grid;grid-template-columns:140px minmax(0,1fr);gap:16px;padding:16px 0;border-bottom:1px solid var(--ss-border)}
.role-h{font-size:16px;font-weight:700;color:var(--ss-t1)}
.role-p{font-size:16px;color:var(--ss-t2);line-height:1.7}

.sec-data{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);border-bottom:1px solid var(--ss-border);padding:24px}
.data-body{font-size:14px;color:var(--ss-t2);line-height:1.8;max-width:44em}
.data-body a{color:var(--ss-brand);text-decoration:none;border-bottom:1px solid currentColor}
.data-body a:hover{border-bottom-color:transparent}

/* 最終 CTA: 本文とボタンは左揃え。中央寄せのバナーにしない。 */
.sec-fcta{background:var(--ss-bg-app);padding:48px 24px}
.fcta-wrap{max-width:1160px;margin:0 auto}
.fcta-h{font-size:clamp(20px,2.2vw,32px);font-weight:700;letter-spacing:-.01em;color:var(--ss-t1);margin-bottom:16px;text-wrap:balance}
.fcta-sub{font-size:16px;color:var(--ss-t2);line-height:1.7;margin-bottom:24px;max-width:34em}

footer{background:var(--ss-surface-1);border-top:1px solid var(--ss-border);padding:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;transition:background var(--dur-base) var(--ease-out)}
.footer-logo{font-size:16px;font-weight:600;letter-spacing:-.01em;color:var(--ss-t1);text-decoration:none;display:flex;align-items:center;gap:8px}
.footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:16px;list-style:none}
.footer-links a{font-size:14px;color:var(--ss-t2);text-decoration:none;white-space:nowrap;padding:8px 6px;min-height:24px;min-width:24px;display:inline-flex;align-items:center;justify-content:center;transition:color var(--dur-fast) var(--ease-out)}
.footer-links a:hover{color:var(--ss-t1)}
.footer-copy{font-size:14px;color:var(--ss-t3)}

@media(max-width:767px){
  .beta-banner{padding:8px 16px}
  nav{padding:0 16px}.nav-links{display:none}.btn-login{display:none}.hamburger{display:flex}
  .hero{padding:24px 16px 40px}.hero-inner{grid-template-columns:minmax(0,1fr);gap:24px}
  .btn-cta{width:100%;justify-content:center}
  .sec{padding:48px 16px}
