{% block content %}{% endblock %}

<footer>
  <a class="footer-logo" href="/"><div class="logo-mark"><img src="/favicon.png" alt=""></div>ShuttleScope</a>
  <ul class="footer-links">
    <li><a href="/terms"><span class="ja">利用規約</span><span class="en">Terms</span></a></li>
