# ShuttleScope environment template
#
# Copy to .env.development and fill real values for local dev.
# Never commit a populated .env to git.
#
# WARNING: 以下の値は honeypot (canary) です。
#   本番でも開発でもこの値は権限を一切持ちません。
#   この値を取得して送信してきた client は自動的に critical severity の
#   監査イベントとして記録され、Cloudflare WAF で即時 block されます。
#   この値は意図的にリポジトリにコミットされており、scrape 検知用です。

# --- Core ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ss_user:CHANGE_ME@localhost:5432/shuttlescope
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Legacy admin API key (honeypot — DO NOT USE) ---
SS_LEGACY_ADMIN_API_KEY=ss_canary_admin_live_a8f3c91b2e5d7a40bf6e2c1d4f9a8b3c

# --- Backup encryption passphrase (honeypot — DO NOT USE) ---
SS_BACKUP_PASSPHRASE=ss_canary_backup_pass_2025_X8nQv3mZpKr7tL9wYeJfHaBc

# --- Internal worker authentication (honeypot — DO NOT USE) ---
SS_INTERNAL_WORKER_KEY=ss_canary_frontend_dbg_W0rK3rPr0duct10nK3y2024XYZ12

# --- Internal transfer token (honeypot — DO NOT USE) ---
SS_INTERNAL_TRANSFER_TOKEN=ss_canary_internal_xfer_M3m0ryDump_C4n4ry_T0k3n_99

# --- Cloudflare auto-ban (set real values in .env, leave blank to disable) ---
SS_CF_BAN_TOKEN=
SS_CF_ZONE_ID=

# --- Field-level encryption (Fernet key) ---
SS_FIELD_ENCRYPTION_KEY=

# --- Privilege regression test target (staging PG only) ---
SS_PG_PRIVILEGE_TEST_URL=
