{
  "name": "shuttlescope",
  "version": "1.0.0",
  "description": "バドミントン動画アノテーション・解析デスクトップアプリ",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 electron-vite build",
    "preview": "node scripts/preview.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "check:i18n": "python scripts/check_module_scope_t.py",
    "check:icons": "python scripts/check_no_emoji_in_jsx.py",
    "check:all": "npm run check:i18n && npm run check:icons && npm run lint"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.101.4",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.9.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "material-symbols": "^0.45.10",
    "psl": "^1.15.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3": "^7.4.3",
    "@types/psl": "^1.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "^10.2.0",
    "tmp": "0.2.7",
    "form-data": "^4.0.6",
    "tar": "^7.5.16",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "esbuild": "^0.28.1"
  }
